{
  "name": "@minhvdv/capacitor-pass-to-wallet",
  "version": "1.2.4",
  "description": "Add passes to Apple Wallet (PassKit) and Google Wallet (Google Pay API) from Capacitor apps",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "Package.swift",
    "MinhvdvCapacitorPassToWallet.podspec",
    "LICENSE"
  ],
  "author": "MinhVDV",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark-ordernow/capacitor-pass-to-wallet.git"
  },
  "bugs": {
    "url": "https://github.com/mark-ordernow/capacitor-pass-to-wallet/issues"
  },
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/MinhVDV"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "apple-wallet",
    "passkit",
    "google-wallet"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "xcodebuild -scheme MinhvdvCapacitorPassToWallet -destination generic/platform=iOS",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api PassToWalletPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && node scripts/google-badges.mjs && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist ./src/generated",
    "watch": "tsc --watch",
    "prepare": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^7.4.4",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.7",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=6.0.0 <9.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "homepage": "https://github.com/mark-ordernow/capacitor-pass-to-wallet#readme"
}
